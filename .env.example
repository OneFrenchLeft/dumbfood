# Recommandé : node scripts/setup.mjs génère un .env avec des secrets uniques.
# Remplacez les deux valeurs ci-dessous avant le premier démarrage.
ADMIN_PASSWORD=
SESSION_SECRET=

PORT=3000
HOST_BIND=0.0.0.0
# false pour http://localhost ; true lorsque le site est servi en HTTPS.
COOKIE_SECURE=false
# Origine publique exacte si un reverse proxy expose le site (ex. https://repas.example.org).
PUBLIC_URL=
# Uniquement pour une installation de démonstration avec une base neuve.
DEMO_DATA=false
